{
  "name": "reporting-dashboard-3d",
  "version": "1.0.0",
  "private": true,
  "description": "3D Animated Project Reporting Dashboard",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npx vite dev",
    "build": "echo 'Node.js project - use npm run dev' && exit 0",
    "lint": "eslint server client/src --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@fontsource/inter": "^5.1.1",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "@vitejs/plugin-react": "^4.3.0",
    "chart.js": "^4.5.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.12.0",
    "prettier": "^3.5.0",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "three": "^0.175.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.3.0"
  }
}