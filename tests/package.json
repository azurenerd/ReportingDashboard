{
  "name": "reporting-dashboard-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --config tests/vitest.config.ts",
    "test:unit": "vitest run --config tests/vitest.config.ts --reporter=verbose tests/server/unit tests/client/unit",
    "test:integration": "vitest run --config tests/vitest.config.ts --reporter=verbose tests/server/integration"
  },
  "devDependencies": {
    "vitest": "^3.1.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.2",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "typescript": "^5.8.0"
  }
}